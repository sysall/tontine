# Copy to .env. Docker Compose reads it, and so does the API when run directly.
# Every value is a URL or a secret, so pointing at a different provider never
# means touching code. Leave a line out to get the local default.

PORT=3000
NODE_ENV=development

# Postgres. The compose stack, a managed instance, anything Prisma can reach.
#   postgresql://tontine_user:tontine_password@postgres:5432/tontine_db?schema=public   compose
#   postgresql://user:pass@host/db?sslmode=require                                      managed
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tontine_db?schema=public"

# Redis. Use the URL form for anything with a password or TLS. REDIS_HOST and
# REDIS_PORT still work for an unauthenticated local instance.
#   redis://redis:6379          compose
#   rediss://default:pass@host  managed, TLS
REDIS_URL="redis://localhost:6379"

# Sign your own. This one is public, it lives in the repo.
JWT_SECRET=super_secret_tontine_express_jwt_key_2026
