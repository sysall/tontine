{
  "expo": {
    "name": "Tontine Express",
    "slug": "tontine",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FDFBF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tontineexpress.app"
    },
    "android": {
      "package": "com.tontineexpress.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "tontineexpress",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "270a2b65-4c7a-4cf3-8a35-27f439da4fba"
      }
    },
    "owner": "tontinexpress"
  }
}
