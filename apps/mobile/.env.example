# Copy to .env and point it wherever your API is running. This is for the dev
# server only. A build takes its URL from the EAS environment its profile names.
#
#   http://localhost:3000/api/v1     iOS simulator or web
#   http://10.0.2.2:3000/api/v1      Android emulator reaching your machine
#   https://<your-tunnel>/api/v1     a phone reaching your machine (ngrok)
#   https://<your-host>/api/v1       a deployed API
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
