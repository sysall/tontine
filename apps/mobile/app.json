{
  "expo": {
    "name": "Tontine Express",
    "slug": "tontine-express",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FDFBF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tontineexpress.app"
    },
    "android": {
      "package": "com.tontineexpress.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "tontineexpress",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5ebf9b91-6455-4f21-94c7-6ba706a7f08e"
      }
    },
    "owner": "tontine-express"
  }
}
