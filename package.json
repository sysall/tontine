{
  "name": "tontine-express-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Tontine Express - Mobile App & Unified NestJS API",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=services/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev": "npm run dev:api",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=services/api",
    "prisma:push": "npm run prisma:push --workspace=services/api"
  },
  "keywords": [
    "tontine",
    "fintech",
    "senegal",
    "expo",
    "react-native",
    "nestjs"
  ],
  "author": "Tontine Express Team",
  "license": "MIT"
}
